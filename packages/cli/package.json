{
  "name": "jsonlex",
  "version": "0.0.0",
  "private": true,
  "description": "JSONL Explorer CLI - serve JSONL files locally for the explorer",
  "homepage": "https://jsonlexplorer.lucasschirm.com/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasschirm/jsonl-explorer.git",
    "directory": "packages/cli"
  },
  "bin": {
    "jsonlex": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsup && node scripts/stage-site.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "lint": "eslint . --cache",
    "pack": "pnpm pack"
  },
  "devDependencies": {
    "@fastify/static": "^7.0.0",
    "@types/node": "^20.11.0",
    "fastify": "^4.26.0",
    "open": "^10.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "files": ["dist", "site"],
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  }
}