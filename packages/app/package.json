    "vue": "^3.4.0",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^0.3.0",
    "@nuxt/nitro-server": "3.21.11",
    "@nuxtjs/tailwindcss": "^6.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.57.0",
    "happy-dom": "^13.0.0",
